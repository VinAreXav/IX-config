* {
		base00: {{colors.secondary_container.default.hex}};
		base01: {{colors.outline_variant.default.hex}};
		base02: {{colors.tertiary.default.hex}};
		base03: {{colors.on_tertiary_container.dark.hex | lighten: -20}};
		base04: {{colors.inverse_primary.default.hex}};
		base05: {{colors.outline_variant.default.hex}};
		base06: {{colors.on_tertiary_container.default.hex}}; 
		base07: {{colors.primary.default.hex}};
		base08: {{colors.surface_variant.default.hex}};
		base09: {{colors.on_secondary_container.default.hex}};
		base0A: {{colors.tertiary.default.hex}};
		base0B: {{colors.outline_variant.default.hex}}CC;
 		base0C: {{colors.on_surface_variant.default.hex}};
		base0D: {{colors.on_tertiary_container.dark.hex | lighten: -20}};
		base0E: {{colors.primary_container.default.hex}};
		base0F: {{colors.secondary.default.hex}};
		back: {{colors.tertiary_container.light.hex}}CC;
		selected: {{colors.primary_container.default.hex}}CC;
		spacing: 0;
		background-color: transparent;
}
